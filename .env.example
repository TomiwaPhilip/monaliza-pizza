# Copy to .env and fill in. Never commit .env.

# Paystack TEST secret key: Paystack Dashboard -> Settings -> API Keys & Webhooks (Test mode).
# The server refuses to start with a live key (sk_live_...).
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: only needed if you build a hosted checkout yourself; the server does not use it.
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bearer token Chord sends to /mcp (set the same value as auth_token when registering the MCP server).
MCP_AUTH_TOKEN=change-me-long-random-string
# Password for the kitchen board at /kitchen (any username).
KITCHEN_PASSWORD=change-me

# Public HTTPS URL of this server (used for the Paystack callback page). Set by the deploy script on Azure.
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080
PAYMENT_EXPIRY_MINUTES=30
# Set true if your Paystack account passes transaction fees to customers
# (Dashboard -> Settings -> Preferences). The agent then quotes the checkout amount incl. fee.
PAYSTACK_FEES_PASSED_TO_CUSTOMER=false

# Optional: push "your pizza is ready" into the customer's WhatsApp thread via Chord.
# Needs a Chord API key with thread:read + thread:write.
CHORD_API_KEY=
CHORD_WORKSPACE_ID=
CHORD_BASE_URL=https://api.chordhq.xyz
